# ==============================================================================
# TEMPLATE KONFIGURASI ENVIRONMENT E-KINERJA AI (.env.example)
# ==============================================================================
# Salin file ini menjadi .env lalu sesuaikan nilainya:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI API KEY
# ------------------------------------------------------------------------------
# Masukkan API Key Gemini dari Google AI Studio (https://aistudio.google.com/app/apikey)
# REKOMENDASI KEAMANAN: Gunakan `GEMINI_API_KEY` agar tersimpan aman di server
# dan TIDAK PERNAH ter-compile ke dalam file JavaScript browser client.
# Jika kosong, sistem otomatis beralih ke Mode Heuristik Cerdas Offline (tanpa API Key).
GEMINI_API_KEY=
# VITE_GEMINI_API_KEY=  (Gunakan opsi ini HANYA jika Anda mendeploy static frontend murni tanpa Node.js server)

# ------------------------------------------------------------------------------
# 2. PENGATURAN DATABASE ADAPTER (SERVER BACKEND)
# ------------------------------------------------------------------------------
# Variabel database di bawah ini hanya dibaca oleh backend Node.js (aman, tidak bocor ke browser):
DB_TYPE=mysql

# A. Konfigurasi Khusus MySQL / MariaDB (Rekomendasi Utama di Easypanel / Docker)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ekinerja_db
DB_USER=root
DB_PASSWORD=secret

# B. Konfigurasi Khusus PostgreSQL (Aktifkan jika DB_TYPE=postgres)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ekinerja_db
# DB_USER=postgres
# DB_PASSWORD=secret

# C. Konfigurasi Khusus SQLite
# SQLITE_FILE=./database/ekinerja.sqlite

# D. Alternatif Connection String URL (Opsional)
# DATABASE_URL=mysql://root:secret@localhost:3306/ekinerja_db
# DATABASE_URL=postgresql://postgres:secret@localhost:5432/ekinerja_db

# ------------------------------------------------------------------------------
# 3. BOT TELEGRAM INTEGRATION
# ------------------------------------------------------------------------------
# Token Bot Telegram didapatkan dari @BotFather di aplikasi Telegram (ketik /newbot)
# Contoh format: 1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567
TELEGRAM_BOT_TOKEN=

# Username Bot Telegram (opsional, tanpa tanda @)
# Contoh: ekinerja_ai_bot
TELEGRAM_BOT_USERNAME=

# ------------------------------------------------------------------------------
# 4. URL PUBLIK APLIKASI (Untuk Tautan Laporan & Berkas Upload)
# ------------------------------------------------------------------------------
# Masukkan domain publik aplikasi Anda di Easypanel/Docker/VPS
# Contoh: https://ekinerja.instansi.go.id atau http://localhost:3000
# Tautan ini akan disematkan ke PDF laporan & bot Telegram agar eviden bisa langsung diklik
APP_URL=

