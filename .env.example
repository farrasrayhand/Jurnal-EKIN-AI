# ==============================================================================
# TEMPLATE KONFIGURASI ENVIRONMENT E-KINERJA AI (.env.example)
# ==============================================================================
# Salin file ini menjadi .env lalu sesuaikan nilainya:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI API KEY
# ------------------------------------------------------------------------------
# Masukkan API Key Gemini dari Google AI Studio (https://aistudio.google.com/app/apikey)
# Kosongkan jika ingin menggunakan Mode Cerdas Offline (Heuristik bawaan tanpa API Key)
VITE_GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. PENGATURAN DATABASE ADAPTER
# ------------------------------------------------------------------------------
# Pilih salah satu tipe database yang digunakan:
# Opsi yang didukung:
#   - mysql    : Database MySQL / MariaDB (Rekomendasi Utama Produksi di Easypanel / Docker)
#   - sqlite   : Database file lokal ringan tanpa instalasi server
#   - postgres : Database PostgreSQL untuk lingkungan enterprise
VITE_DB_TYPE=mysql

# A. Konfigurasi Khusus SQLite
VITE_SQLITE_FILE=./database/ekinerja.sqlite

# B. Konfigurasi Khusus PostgreSQL (Aktifkan jika VITE_DB_TYPE=postgres)
# VITE_DB_HOST=localhost
# VITE_DB_PORT=5432
# VITE_DB_NAME=ekinerja_db
# VITE_DB_USER=postgres
# VITE_DB_PASSWORD=secret

# C. Konfigurasi Khusus MySQL / MariaDB (Aktifkan jika VITE_DB_TYPE=mysql)
# VITE_DB_HOST=localhost
# VITE_DB_PORT=3306
# VITE_DB_NAME=ekinerja_db
# VITE_DB_USER=root
# VITE_DB_PASSWORD=secret

# D. Alternatif Connection String URL (Opsional)
# VITE_DATABASE_URL=sqlite:./database/ekinerja.sqlite
# VITE_DATABASE_URL=postgresql://postgres:secret@localhost:5432/ekinerja_db
# VITE_DATABASE_URL=mysql://root:secret@localhost:3306/ekinerja_db

# ------------------------------------------------------------------------------
# 3. BOT TELEGRAM INTEGRATION
# ------------------------------------------------------------------------------
# Token Bot Telegram didapatkan dari @BotFather di aplikasi Telegram (ketik /newbot)
# Contoh format: 1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567
TELEGRAM_BOT_TOKEN=

# Username Bot Telegram (opsional, tanpa tanda @)
# Contoh: ekinerja_ai_bot
TELEGRAM_BOT_USERNAME=

# ------------------------------------------------------------------------------
# 4. URL PUBLIK APLIKASI (Untuk Tautan Laporan & Berkas Upload)
# ------------------------------------------------------------------------------
# Masukkan domain publik aplikasi Anda di Easypanel/Docker/VPS
# Contoh: https://ekinerja.instansi.go.id atau http://localhost:3000
# Tautan ini akan disematkan ke PDF laporan & bot Telegram agar eviden bisa langsung diklik
APP_URL=

